 cma_find_orphans() {
   local resolved=" $1 " pdir; pdir="$(cma_providers_dir)"
+  # --- T005 DIAGNOSIS INSTRUMENTATION (temporary; SpecKit 003 T005) -----------
+  # Records the resolved set this function actually compares against. OPT-IN:
+  # writes only when CMA_T005_TRACE names a file, so an unset var leaves both
+  # behaviour and cost byte-identical to the uninstrumented function. Nothing
+  # here is read by any branch below (§11.4.128 observer-effect budget).
+  if [[ -n "${CMA_T005_TRACE:-}" ]]; then
+    { printf 'T005_TRACE_AT=%s\n' "$(date -u +%FT%TZ)"
+      printf 'T005_RESOLVED_ARG_RAW=[%s]\n' "$1"
+      printf 'T005_RESOLVED_COUNT=%s\n' "$(printf '%s' "$1" | tr ' ' '\n' | sed '/^$/d' | wc -l)"
+      printf '%s' "$1" | tr ' ' '\n' | sed '/^$/d' | sed 's/^/T005_RESOLVED_ID=/'
+    } >> "$CMA_T005_TRACE" 2>/dev/null || true
+  fi
   local sf; sf="$(cma_status_cache)"
   local candidates="" cid
   if [[ -s "$sf" ]]; then
@@ -1963,6 +1975,12 @@
     done
   fi
   for cid in $candidates; do
+    if [[ -n "${CMA_T005_TRACE:-}" ]]; then
+      _t005_in=no; case "$resolved" in *" $cid "*) _t005_in=yes ;; esac
+      _t005_env=no; [[ -f "$pdir/$cid.env" ]] && _t005_env=yes
+      printf 'T005_CANDIDATE=%s IN_RESOLVED=%s HAS_ENV=%s\n' "$cid" "$_t005_in" "$_t005_env" \
+        >> "$CMA_T005_TRACE" 2>/dev/null || true
+    fi
     case "$resolved" in *" $cid "*) continue ;; esac
     # NOT EVERY UNRESOLVED ID IS AN ORPHAN — SOME HAVE A DIFFERENT OWNER.
     #

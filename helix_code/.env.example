# HuggingFace authentication tokens
# Required for: image-gen (FLUX.1-schnell/dev), video-gen (WAN, LTX-Video)
# Account must accept model terms at huggingface.co before token works
# Set both HF_TOKEN and HUGGINGFACE_TOKEN to the same value
HF_TOKEN=<your_huggingface_token>
HUGGINGFACE_TOKEN=<your_huggingface_token>

# Nunchaku NVFP4 wheel path (Blackwell RTX 5090)
# Required for: image-gen FLUX NVFP4 inference
# Download from: https://github.com/nunchaku-ai/nunchaku
NUNCHAKU_WHEEL=<path_to_nunchaku_whl>

# Optional: SonarQube endpoint overrides (non-secret — leave unset for the
# standard local docker/security/sonarqube stack).
#
# Read by BOTH halves of the SonarQube scan path, with these same defaults:
#   - scripts/security-scan.sh  (boots + polls the server)
#   - cmd/security_scan/main.go (sonarqubeHost() / sonarqubePort())
# Setting them in this file relocates both halves together; setting only one
# half would produce a split brain (one boots endpoint X, the other polls
# localhost:9000). Used by: make scan-sonarqube, ./scripts/security-scan.sh
# sonarqube|start-sonar.
# HELIX_SONARQUBE_HOST=localhost
# HELIX_SONARQUBE_PORT=9000
#
# SonarQube's backing PostgreSQL sidecar (same compose file). Scoped to
# SonarQube so it never collides with the application's own DB_HOST / DB_PORT.
# HELIX_SONARQUBE_DB_HOST=localhost
# HELIX_SONARQUBE_DB_PORT=5432

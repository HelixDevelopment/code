{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix.dev/schemas/006/endpoint-registration.schema.json",
  "title": "EndpointRegistration",
  "description": "Delta payload for explicit endpoint registration/advertisement/deregistration (A4), extending the existing discovery.Instance + health.Tracker.",
  "type": "object",
  "required": ["instance_id", "state", "registered_at"],
  "additionalProperties": false,
  "properties": {
    "instance_id": { "type": "string", "description": "identifier of the existing discovery.Instance", "minLength": 1 },
    "state": { "type": "string", "enum": ["registered", "unhealthy", "deregistered"] },
    "capabilities": {
      "type": "array",
      "description": "Advertised model/backend capabilities; MUST be empty once state=deregistered",
      "items": {
        "type": "object",
        "required": ["model_id"],
        "properties": {
          "model_id": { "type": "string" },
          "capability_family": { "type": "string", "description": "e.g. text, vision, tts, stt, embedding" },
          "backend": { "type": "string", "description": "e.g. llamacpp, colibri" }
        }
      }
    },
    "registered_at": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "deregistered" } } },
      "then": { "properties": { "capabilities": { "maxItems": 0 } } }
    }
  ]
}
